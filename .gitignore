# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Python packaging and build output
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test, type-check, lint, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local environment and secrets
.env
.env.*
!.env.example
*.local

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp

# Frontend dependencies and build output
node_modules/
frontend/node_modules/
frontend/.next/
frontend/dist/
frontend/build/
frontend/coverage/

# Docker and local service volumes
.docker/
docker-data/
postgres-data/
redis-data/
orthanc-storage/

# Real downloaded medical imaging data and generated derivatives
datasets/downloads/*
!datasets/downloads/.gitignore
datasets/derived/*
!datasets/derived/.gitignore
datasets/raw/*
!datasets/raw/.gitignore
outputs/visualizations/

# IDE and operating system files
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini
